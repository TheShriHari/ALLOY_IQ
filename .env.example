# ════════════════════════════════════════════════════════════════════════════
#  ALLOY IQ — Environment Variables Template
#  Copy this file to .env and fill in your actual credentials.
#  NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════════

# ── Materials Project API ────────────────────────────────────────────────────
# Obtain at: https://next-gen.materialsproject.org/api
MP_API_KEY=your_materials_project_api_key_here

# ── AFLOW REST API ───────────────────────────────────────────────────────────
# No key required, but set base URL (override for mirror servers if needed)
AFLOW_BASE_URL=http://aflow.org/API/aflowlib.org

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── Output Paths ─────────────────────────────────────────────────────────────
PROCESSED_DATA_DIR=backend/data/processed
RAW_DATA_DIR=backend/data/raw
PDF_DIR=backend/data/pdfs

# ── Pipeline Configuration ───────────────────────────────────────────────────
# Max concurrent AFLOW async requests (stay under rate limits)
AFLOW_MAX_CONCURRENT=5
# Exponential backoff: initial wait in seconds
AFLOW_BACKOFF_BASE=1.0
AFLOW_MAX_RETRIES=5

# ── Agent Tracker ────────────────────────────────────────────────────────────
AGENT_TRACKER_PATH=agent_tracker.json

# ── Backend Configuration ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./alloy_iq.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_HEX
BLENDER_PATH=blender
RENDERS_DIR=frontend/public/renders

# ── Frontend Configuration ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

